        {
          "flow": [
            {
              "id": 7,
              "module": "util:SetVariable",
              "version": 1,
              "parameters": {},
              "filter": {
                "name": "Error Handler - Log Failed Execution",
                "conditions": [
                  [
                    {
                      "a": "{{4.statusCode}}",
                      "o": "number:notequal",
                      "b": "200",
                      "t": "number"
                    }
                  ]
                ]
              },
              "mapper": {
                "name": "errorLog",
                "scope": "roundtrip",
                "value": "{\n  \"timestamp\": \"{{now}}\",\n  \"error\": \"Failed to create contact in GoHighLevel\",\n  \"statusCode\": \"{{4.statusCode}}\",\n  \"response\": \"{{4.data}}\",\n  \"customerData\": {\n    \"email\": \"{{1.email}}\",\n    \"phone\": \"{{1.phone}}\",\n    \"name\": \"{{1.first_name}} {{1.last_name}}\"\n  }\n}"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 150
